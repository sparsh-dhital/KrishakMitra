{
  "name": "smart-mandi-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "npx vite --host 127.0.0.1 --port 5173",
    "dev:network": "npx vite --host 0.0.0.0 --port 5173",
    "dev:all": "concurrently -k -n API,WEB -c blue,green \"cd ../backend && uvicorn app.main:app --reload --host 127.0.0.1 --port 8000\" \"npx vite --host 127.0.0.1 --port 5173\"",
    "build": "npx vite build",
    "preview": "npx vite preview"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "framer-motion": "^13.2.0",
    "i18next": "^26.4.2",
    "lenis": "^1.3.26",
    "lucide-react": "^1.42.0",
    "react": "latest",
    "react-dom": "latest",
    "react-hot-toast": "^2.6.0",
    "react-i18next": "^17.0.13",
    "react-qr-code": "^2.2.0",
    "@supabase/supabase-js": "^2.57.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "latest",
    "@vitejs/plugin-react": "latest",
    "concurrently": "latest",
    "tailwindcss": "latest",
    "vite": "latest"
  }
}
